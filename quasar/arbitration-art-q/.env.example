# =============================================================================
# arbitration-art-q (Quasar frontend) — template
# Copy to .env and fill in the values.
# =============================================================================

# Django REST API base URL. Must match arbitration-art-django host/port and the
# /api prefix from arbitration_art_django/urls.py.
API_URL=http://127.0.0.1:8000/api

# art-level-screener levels-api base URL (levels screener section). Points at the
# levels-api service host/port (no /api prefix, no auth). Must match its HOST/PORT.
LEVELS_API_URL=http://127.0.0.1:3000
