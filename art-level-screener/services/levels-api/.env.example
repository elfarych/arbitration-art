# --- HTTP ---
HOST=0.0.0.0
PORT=3000

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Префикс рассчитанных уровней (timeframes/health). Должен совпадать с OUTPUT_PREFIX процессора
LEVELS_PREFIX=levels
# Префикс сырых свечей коннектора — источник расчёта по запросу. Должен совпадать с REDIS_KEY_PREFIX коннектора
SOURCE_PREFIX=binance-futures

# --- CORS ---
# Разрешённые origin: * или список через запятую
CORS_ORIGIN=*

# --- Таймфреймы ---
# Список ТФ для /timeframes и /screener (через запятую). Независим от процессора;
# должен соответствовать ТФ коннектора (TIMEFRAMES коннектора)
TIMEFRAMES=1m,5m,15m,1h

# --- Параметры расчёта уровней (дефолты; часть переопределяется query) ---
# natrMultiplier и minGap можно переопределить в запросе; остальные фиксированы
PERIOD=40
EXTREMA_WINDOW=20
MAX_BROKEN_AGE=30
MIN_TOUCHES=2
MIN_GAP=12
NATR_MULTIPLIER=0.3
ATR_PERIOD=14

# --- Объёмный пре-фильтр (USDT-оборот) ---
# Оборот = сумма volume·close по последним VOLUME_LOOKBACK свечам VOLUME_TIMEFRAME
VOLUME_TIMEFRAME=1h
VOLUME_LOOKBACK=24

# --- Анализ пробоев (GET /analysis/:tf/:symbol) ---
# Источник свечей и трейдов — Binance USDⓈ-M Futures REST напрямую (публичные данные, без ключей)
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# Поминутный бюджет веса запросов Binance Futures (по умолчанию биржи — 2400)
BINANCE_WEIGHT_LIMIT_PER_MIN=2400
# Сколько свечей грузить по умолчанию и максимум (klines >1500 грузятся пагинацией)
ANALYSIS_DEFAULT_CANDLES=1000
ANALYSIS_MAX_CANDLES=10000
# Размер страницы aggTrades (макс. 1000) и лимит страниц на один пробой
# (cross ищется по всей свече пробоя, поэтому страниц нужно больше)
ANALYSIS_AGG_TRADES_LIMIT=1000
ANALYSIS_MAX_TRADE_PAGES=12

# --- Логи ---
LOG_LEVEL=info
