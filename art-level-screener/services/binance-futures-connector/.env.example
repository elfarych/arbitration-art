# --- Binance REST/WS ---
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# Сторож «немого» сокета: нет сообщений столько мс → принудительный реконнект
WS_STALE_TIMEOUT_MS=30000
# Безопасный бюджет веса REST в минуту (биржевой лимит ~2400; берём с запасом)
REST_WEIGHT_LIMIT_PER_MIN=2400

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=binance-futures

# --- Фильтр символов ---
# Минимальный суточный объём (quoteVolume, USDT)
MIN_24H_VOLUME_USDT=10000

# --- Коннектор ---
SYMBOLS_PER_CONNECTOR=20
SNAPSHOT_DEPTH=1000
# Базовый таймфрейм 1m обязателен (из него агрегируются старшие)
TIMEFRAMES=1m,5m,15m,1h

# --- Интервалы (мс) ---
FLUSH_INTERVAL_MS=3000
REFRESH_INTERVAL_MS=3600000

# --- Логи ---
LOG_LEVEL=info
