# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Префикс свечей (должен совпадать с REDIS_KEY_PREFIX коннектора)
SOURCE_PREFIX=binance-futures

# --- Цикл ---
# Период тика (мс)
INTERVAL_MS=10000
# Антиспам: тишина по паре (пользователь+ТФ+монета+уровень), мс (30 мин)
NOTIFY_COOLDOWN_MS=1800000

# --- Ценовые уведомления (отдельный проход; читает binance-futures:price:<SYM>) ---
# Мастер-переключатель прохода ценовых алертов
PRICE_NOTIFICATIONS_ENABLED=true
# Пропускать цену, если :updated: старше этого порога (защита от замороженного фида), мс
PRICE_MAX_STALENESS_MS=60000

# --- Django (источник активных конфигов) ---
# Базовый URL с /api
DJANGO_API_URL=http://127.0.0.1:8000/api
# Должен совпадать с SERVICE_SHARED_TOKEN в arbitration-art-django/.env и arbitration-bot-engine/.env
SERVICE_SHARED_TOKEN=replace-with-shared-service-token

# --- Telegram ---
# Токен бота от @BotFather (один на сервис; chat_id у каждого пользователя свой)
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# --- Ссылка в уведомлении ---
# Origin фронтенда; ссылка собирается как ${SITE_BASE_URL}/#/levels/SYMBOL?tf=TF
SITE_BASE_URL=http://localhost:9000

# --- Объёмный пре-фильтр (как в скринере: сумма volume·close по lookback свечам timeframe) ---
VOLUME_TIMEFRAME=1h
VOLUME_LOOKBACK=24

# --- Дефолты расчёта уровней (как у levels-processor / levels-api) ---
# Per-config natrMultiplier / minGap переопределяют эти значения.
PERIOD=40
EXTREMA_WINDOW=20
MAX_BROKEN_AGE=30
MIN_TOUCHES=2
MIN_GAP=12
NATR_MULTIPLIER=0.3
ATR_PERIOD=14

# --- Логи ---
LOG_LEVEL=info
