# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Префикс, откуда читаются свечи (пишет коннектор)
SOURCE_PREFIX=binance-futures
# Префикс, куда пишутся уровни для скринера/API
OUTPUT_PREFIX=levels
# TTL ключей вывода (мс): выбывшие монеты сами исчезают
OUTPUT_TTL_MS=30000

# --- Обработка ---
# Таймфреймы для расчёта (должны быть в источнике)
TIMEFRAMES=1m,5m,15m,1h
# Период цикла расчёта (мс)
INTERVAL_MS=10000

# --- Параметры уровней (как в Python level_screener) ---
PERIOD=40                 # окно значимого экстремума
EXTREMA_WINDOW=20         # отступ от правого края
MAX_BROKEN_AGE=30         # макс. возраст пробоя (свечей) для broken
MIN_TOUCHES=2             # мин. касаний ценой для валидного уровня
MIN_GAP=12                # мин. свечей между касаниями
NATR_MULTIPLIER=0.3       # допуск зоны касания = множитель × NATR
ATR_PERIOD=14             # период ATR для NATR

# --- Логи ---
LOG_LEVEL=info
